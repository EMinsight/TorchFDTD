  "data/landscape/prior_works_landscape.json": {
   "scope": "Transcription of internal notes (audit dated 2026-09-30) for the Supplementary Fig. 8a landscape. Only numbers stated in the audit are used. Aperture is the width (2D) or diameter/side (3D) in vacuum wavelengths as stated by each work, or derived from a stated size and wavelength. Entries without a stated wavelength are kept with aperture_lambda null and are not placed on the axis. Grid points, matrix sizes, repeated mask pixels and independent design variables are not mixed. Addendum 2026-09-30: the Skarda wavelengths were taken from the published paper itself at the orchestrator request, with the quoted sentences in each source field.",
   "audit": "internal notes",
   "rows": [
    {
     "row": "ours",
     "label": "This work",
     "sub": "full-layer density, 3D FDTD tiles",
     "em": "3D"
    },
    {
     "row": "zda",
     "label": "Zoned axisymmetry",
     "sub": "zone densities, 3D FDTD",
     "em": "3D",
     "cite": "fa_zda2025"
    },
    {
     "row": "tmatrix",
     "label": "Distributed T-matrix",
     "sub": "post positions and radii, 3D",
     "em": "3D",
     "cite": "fa_skarda2022"
    },
    {
     "row": "whole",
     "label": "Whole-structure FDTD",
     "sub": "post widths, 3D",
     "em": "3D",
     "cite": "fa_mansouree2021"
    },
    {
     "row": "lpa",
     "label": "Locally periodic",
     "sub": "cell densities, 3D RCWA per cell",
     "em": "3D",
     "cite": "fa_lpa2019"
    },
    {
     "row": "oda",
     "label": "Overlapping domains",
     "sub": "layer densities, 2D",
     "em": "2D",
     "cite": "cpc_lin2019"
