# Shared by E1, E2 and E3 (sourced by run.sh, evaluate.sh and smoke.sh). Values are those of the production runs.
# Physics: 20 nm Yee lattice, z 2.5 um, 1200 time steps, tile margin FF_OVER 0.9 um (scoring uses 3.6 um, see evaluate.sh),
# SiN 700 nm (n 2.0) on SiO2 (n 1.444), float32 fields, complex128 angular-spectrum propagation.
FF_ALGO=zonec
FF_INIT_DESIGN=w240
FF_FOCAL_UM=333.3333333333
FF_OVER=0.9
FF_OWNGRAD=0
FF_L9_DUALPOL=1
FF_L9_ANISO=1
# solver execution: boundary trace on the GPU; FF_GPU_GIB caps one solve, admission is 80 % of the free memory
FF_TRACE=device
FF_HOST_GIB=150
FF_FAST_DIAG=1
FF_FAST_SYNC=1
FF_FAST_NOGRAD=1
FF_FAST_SPEC=1
FF_FAST_OBS=1
# exact kernel patches of src/b200_kernels.py (bit-identical or float32 round-off, see its docstring); needs cupy
FF_B200_KERNELS=1
FF_B200_INTERVAL=pil
FF_B200_FUSE_EG=1
FF_B200_HYGIENE=1
FF_B200_AUTOTUNE=1
FF_B200_FUSED_EH=0
FF_B200_FUSED_ADJ=0
FF_NCCL_TIMEOUT_S=7200
# design representation and optimizer
EZ_P=290
EZ_POLAR=1
EZ_SNAP=1
EZ_SUPER=1
EZ_VALIDMAP=1
EZC_INIT=grey
EZC_NOISE=0.15
EZC_SEED=20260926
EZC_B0=2
EZC_BMAX=256
EZC_RF=2.0
EZC_LR=0.05
EZC_LRBETA=0.4
EZC_LRLAST=0.05
EZC_WARM=3
EZC_RESTART=1
EZC_BINEVAL=2
EZC_GW=0
EZC_FINALPOLISH=0
EZC_RMAX=0
EZC_HTDIAG=
EZC_ADAPT=1
# adaptive-schedule settings of the final launches; inactive while EZC_BETA_TABLE is set (run.sh sets it)
EZC_BFAC=1.3
EZC_SMIN=5
EZC_SMAX=1000
EZC_SMOOTH=0
EZC_STALL=0.003
# bookkeeping and I/O
FA_TILE_SELECT=cells
FA_COMPRESS_STEPS=1
FA_SAVE_QUEUE=6
FA_TKEEP_EVERY=10
FA_STALL_S=2400
# one recorded forward per tile and step, boundary trace kept until the adjoint (src/fa_keep_trace.py);
# FA_KEEP_TRACE=0 recomputes it instead (same gradient to float32 round-off, about 28 % slower)
FA_KEEP_TRACE=1
SM_NO_CARRIER=1
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
MKL_NUM_THREADS=4
PYTHONUNBUFFERED=1
TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=0
NVIDIA_TF32_OVERRIDE=0
