# E3: polarization-switched hologram, 100 x 100 um square aperture without symmetry, 540 nm: x input shows "CNU", y input "PHY"
# at z = 200 um. Driver ns_run.py: full-aperture Cartesian 10 nm density, 25 um tile cores on the edge grid (4 x 4 tiles x 2 polarizations).
# Reference run: 6 x H200, 190 steps (about 65 GB per GPU at the 25 um tile).
FA_CASE=e3
FA_DRIVER=ns_run.py
FA_OBJECTIVE=e3_pol_holo
FA_LAM_NM=540
FA_POLS=xy
FA_OBJ_CFG='{"aperture": "square", "radius_um": 50.0, "z_um": 200.0, "window_um": 80.0}'
FF_LENS=s100
FF_APERTURE_UM=100
FF_TILE=25
FA_TILE_GRID=edge
FF_GPU_GIB=125
FF_B200_ADJ_FAST=0
FA_KEEP_MAX_UNITS=auto
FA_KEEP_DEVICE=0
# host RAM left free by the kept traces; the reference node had about 2 TB of host RAM. A smaller value keeps more traces in RAM.
FA_KEEP_HOST_RESERVE_GIB=1100
FA_OPT_OFFLOAD=1
FA_RHO_EVERY=0
FA_GRAD_EVERY=0
FA_STATE_KEEP_EVERY=10
# schedule settings of the final launch (inactive with EZC_BETA_TABLE)
EZC_BCONT=1.1
EZC_BINSTALL=10
EZC_BINSTALL_REL=0.002
EZC_GAPSTOP=0.01
EZC_SMIN0=50
EZC_SMOOTH_TO=0
EZC_STALL_REL=0.0028
