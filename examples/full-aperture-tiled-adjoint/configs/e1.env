# E1: 200 um achromatic lens, D4 symmetry, f = 333.3 um, 9 wavelengths 420-670 nm, x and y polarization.
# Driver zonec_multi.py: polar-grid octant density, 19 um tile cores, 16 octant tiles x 2 polarizations = 32 solves per step.
# Reference run: 8 x H200, 250 steps.
FA_CASE=e1
FA_DRIVER=zonec_multi.py
FA_OBJECTIVE=e1_achromat
FA_LAM_NM=420,450,470,510,540,570,600,635,670
FF_LENS=d200
FF_APERTURE_UM=200
FF_TILE=19
FF_GPU_GIB=72
FA_KEEP_MAX_UNITS=4
FA_OPT_OFFLOAD=0
FA_RHO_EVERY=10
FA_GRAD_EVERY=10
# schedule settings of the final launch (inactive with EZC_BETA_TABLE)
EZC_BCONT=1.1
EZC_STALL_REL=0.0028
