# E2: RGB hologram from a 150 x 150 um square aperture without symmetry, x polarization, 450/540/635 nm, image plane z = 300 um.
# Driver ns_run.py: full-aperture Cartesian 10 nm density, 19 um tile cores on the edge grid (8 x 8 = 64 tiles).
# Reference run: 6 x H200 (steps 0-9), then 8 x H100 80GB (steps 10-158), 159 steps.
FA_CASE=e2
FA_DRIVER=ns_run.py
FA_OBJECTIVE=e2_rgb_holo
FA_LAM_NM=450,540,635
FA_POLS=x
FA_OBJ_CFG='{"aperture": "square", "radius_um": 75.0, "z_um": 300.0, "window_um": 120.0}'
FF_LENS=s150
FF_APERTURE_UM=150
FF_TILE=19
FA_TILE_GRID=edge
FF_GPU_GIB=72
FF_B200_ADJ_FAST=0
FA_KEEP_MAX_UNITS=2
FA_KEEP_DEVICE=0
FA_OPT_OFFLOAD=1
FA_RHO_EVERY=0
FA_GRAD_EVERY=0
FA_STATE_KEEP_EVERY=10
# schedule settings of the final launch (inactive with EZC_BETA_TABLE)
EZC_BCONT=1.05
EZC_BCONT_FROM=0
EZC_BFREEZE=0
EZC_RAISE_ON_PEAK=0
EZC_BINGAIN_STOP=0.003
EZC_BINSTALL=10
EZC_BINSTALL_REL=0.002
EZC_GAPSTOP=0
EZC_SMIN0=
EZC_SMOOTH_TO=0
EZC_STALL_REL=0.005
