  "physics_configuration": {
    "module": "tests/test_memory_accounting_g5.py with the scatterer of tests/g5_support.py (24 x 16 x 16 cells, 40 steps, two point probes, full time history)",
    "runs": "StreamedSimulation forward and backward with host_sync, disk_sync and host_async CUDA tiles (slab_width 6, temporal_depth 4, checkpoints 2), one CPU-tile run with host banks, and two MemoryMeter phases around explicit CUDA allocations",
    "instrument_module": "torchfdtd/memory_accounting.py: MemoryMeter around each phase of torchfdtd/streamed.py::_Streamed (report['forward_memory'], report['backward_memory'])",
    "fields": {
      "peak_torch_allocated_bytes": "torch.cuda.max_memory_allocated (exact when the phase set a new process peak or began at it, otherwise the sampled torch.cuda.memory_allocated lower bound, flagged exact=false); at_start_bytes, delta_bytes, prior_process_peak_bytes",
      "peak_torch_reserved_bytes": "torch.cuda.max_memory_reserved with the same exactness rule",
      "cuda_process_memory_bytes": "torch.cuda.mem_get_info free-memory decrease during the phase, device-wide, sampled every 20 ms and at the end; nvidia-smi --query-compute-apps used_memory for this pid when the driver exposes it (N/A under WDDM on Windows, reported as null with the reason)",
      "peak_process_rss_bytes": "working set from psapi.GetProcessMemoryInfo (Windows) or /proc/self/status VmRSS (Linux), sampled every 20 ms and at the phase boundaries, with the OS lifetime peak",
      "peak_process_private_bytes": "PrivateUsage (Windows) or RssAnon (Linux)",
      "peak_process_committed_bytes": "PagefileUsage commit charge (Windows) or VmSize (Linux, labelled virtual size)",
      "os_file_cache_bytes": "psapi.GetPerformanceInfo SystemCache times PageSize (Windows) or /proc/meminfo Cached (Linux): change over the phase, system-wide",
      "scratch_disk_written_bytes, scratch_disk_read_bytes": "StateStore logical byte counters of the scratch bank files plus the process I/O counter deltas (GetProcessIoCounters or /proc/self/io)",
      "scratch_disk_bandwidth_bytes_per_second": "logical scratch bytes divided by the phase wall time",
      "scratch_disk_peak_file_bytes": "peak sum of live scratch bank file sizes; every bank file is truncated to its size and the size is read back with os.fstat",
      "host_bank_bytes": "SlabBlockOperator bank ledger: peak and created bytes of live host field banks released through weak references"
    },
    "caveats_written_into_every_record": "each field carries instrument, caveat and domain (device, host, system, disk); total_memory_bytes is null with a note that the fields overlap; the SCOPE text states which fields contain which"
  },
  "reference_method": "internal consistency of the instruments: the Torch allocator's own counters, the OS process counters and the StateStore file sizes read back with os.fstat; no physics oracle is involved",
